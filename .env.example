OLLAMA_BASE_URL=http://localhost:11434
# Optional: install Ollama and pull a model (e.g. ollama pull llama3.2), then set OLLAMA_MODEL=llama3.2.
# Leave unset to use the built-in, no-cost local parser and resume generator.
OLLAMA_MODEL=
# Optional Gemini structured-output mode. Leave blank to keep all processing local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
MAX_UPLOAD_MB=8
# Set to 1 only when deployed behind exactly one trusted reverse proxy.
TRUST_PROXY=0